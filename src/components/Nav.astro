---
import Flower from './Flower.astro';
import Logo from './Logo.astro';
import { profile } from '../data/portfolio';

const links = [
  { label: 'About', href: '/#about' },
  { label: 'Speaking', href: '/#speaking' },
  { label: 'Projects', href: '/#projects' },
  { label: 'Libraries', href: '/#libraries' },
  { label: 'Services', href: '/#services' },
  { label: 'FAQ', href: '/#faq' },
  { label: 'Contact', href: '/#contact' },
];
---

<header class="nav" data-nav>
  <div class="nav-inner wrap">
    <a class="brand" href="/" aria-label={profile.name}>
      <Logo />
    </a>

    <nav class="nav-links" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a
        class="nav-github"
        href={profile.socials.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"
          ></path>
        </svg>
      </a>
      <Flower class="nav-flower" />
    </nav>

    <button class="nav-burger" data-burger aria-label="Open menu" aria-expanded="false">
      <span></span><span></span>
    </button>
  </div>

  <div class="nav-mobile" data-mobile-menu>
    {links.map((l) => <a href={l.href} data-mobile-link>{l.label}</a>)}
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    padding-block: 18px;
    mix-blend-mode: normal;
    transition: background 0.4s ease, backdrop-filter 0.4s ease, padding 0.4s ease;
  }
  .nav[data-scrolled] {
    background: rgba(243, 244, 221, 0.72);
    backdrop-filter: blur(14px);
    padding-block: 12px;
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* Sit above the fullscreen mobile overlay (z-index 90) so the burger /
       close button and logo stay visible and tappable while it's open. */
    position: relative;
    z-index: 95;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    color: var(--ink);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2vw, 34px);
  }
  .nav-links a {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    transition: color 0.25s ease;
  }
  .nav-links a:hover { color: var(--ink); }
  .nav-github {
    display: inline-flex;
    align-items: center;
    color: var(--ink-soft);
  }
  .nav-github svg { display: block; }
  .nav-github:hover { color: var(--ink); }
  .nav-burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 6px;
  }
  .nav-burger span {
    width: 26px;
    height: 1.6px;
    background: var(--ink);
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  /* When the menu is open the burger turns into a close (X) over the dark
     overlay — recolour the bars to cream so the X is actually visible. */
  .nav[data-open] .nav-burger span { background: var(--cream); }
  .nav[data-open] .brand { color: var(--cream); }
  .nav[data-open] .nav-burger span:first-child { transform: translateY(3.3px) rotate(45deg); }
  .nav[data-open] .nav-burger span:last-child { transform: translateY(-3.3px) rotate(-45deg); }

  .nav-mobile {
    position: fixed;
    inset: 0;
    background: var(--green-800);
    color: var(--cream);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    padding: var(--gutter);
    transform: translateY(-100%);
    transition: transform 0.5s cubic-bezier(0.7, 0, 0.2, 1), visibility 0s linear 0.5s;
    visibility: hidden;
    z-index: 90;
  }
  .nav[data-open] .nav-mobile {
    transform: translateY(0);
    visibility: visible;
    transition: transform 0.5s cubic-bezier(0.7, 0, 0.2, 1);
  }
  .nav-mobile a {
    font-family: var(--serif);
    font-size: clamp(40px, 12vw, 76px);
    color: var(--cream);
    line-height: 1.05;
  }
  .nav-mobile a:nth-child(even) { font-style: italic; }

  /* Mobile menu only exists below the breakpoint. */
  @media (min-width: 821px) {
    .nav-mobile { display: none; }
  }
  @media (max-width: 820px) {
    .nav-links { display: none; }
    .nav-burger { display: flex; }
  }
  /* Short / landscape phones: 6 big links won't fit a centered column, so
     anchor to the top and allow the overlay itself to scroll. */
  @media (max-width: 820px) and (max-height: 600px) {
    .nav-mobile { justify-content: flex-start; padding-top: 84px; overflow-y: auto; }
    .nav-mobile a { font-size: clamp(26px, 9vw, 40px); }
  }
</style>

<script>
  const nav = document.querySelector('[data-nav]') as HTMLElement;
  const burger = document.querySelector('[data-burger]') as HTMLButtonElement;
  const onScroll = () => {
    if (window.scrollY > 40) nav.setAttribute('data-scrolled', '');
    else nav.removeAttribute('data-scrolled');
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const toggle = (open?: boolean) => {
    const isOpen = open ?? !nav.hasAttribute('data-open');
    nav.toggleAttribute('data-open', isOpen);
    burger.setAttribute('aria-expanded', String(isOpen));
    document.body.style.overflow = isOpen ? 'hidden' : '';
  };
  burger?.addEventListener('click', () => toggle());
  document.querySelectorAll('[data-mobile-link]').forEach((a) =>
    a.addEventListener('click', () => toggle(false))
  );
</script>
