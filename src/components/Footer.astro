---
import Logo from './Logo.astro';
import { profile } from '../data/portfolio';
const year = new Date().getFullYear();
---

<footer class="footer dark">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <Logo class="footer-logo" />
      <span class="footer-name">{profile.name.split(' ')[0]} <em class="italic">{profile.name.split(' ')[1]}</em></span>
      <span class="footer-role">{profile.role} · {profile.location}</span>
    </div>

    <div class="footer-meta">
      <span>© {year} — All rights reserved</span>
      <a href="#top" class="to-top">Back to top ↑</a>
    </div>
  </div>
</footer>

<style>
  .footer { padding-block: clamp(40px, 6vw, 70px); border-top: 1px solid var(--line); }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
  }
  .footer-logo { height: 28px; margin-bottom: 14px; color: var(--cream); }
  .footer-name { font-family: var(--serif); font-size: clamp(34px, 5vw, 60px); display: block; }
  .footer-name em { color: var(--accent); }
  .footer-role {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .footer-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .to-top { transition: color 0.3s ease; }
  .to-top:hover { color: var(--accent); }
  @media (max-width: 560px) {
    .footer-meta { align-items: flex-start; }
  }
</style>
