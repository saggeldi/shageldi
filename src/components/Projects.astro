---
import { projects } from '../data/portfolio';
import Flower from './Flower.astro';

const withIndex = projects.map((p, i) => ({ ...p, n: i }));
---

<section class="projects" id="projects" data-h-scroll>
  <div class="pin-wrap" data-pin-wrap>
    <div class="wrap proj-head">
      <h2 class="section-title" data-reveal>
        Projects <Flower />
      </h2>
      <span class="eyebrow proj-count" data-reveal>
        {projects.length} selected · scroll to explore →
      </span>
    </div>

    <div class="h-track-outer">
      <div class="h-track" data-h-track>
        <div class="h-grid">
          {withIndex.map((p) => (
            <a class="card hover-3d" href={`/projects/${p.slug}`} data-card aria-label={p.name}>
              <div class="folder" data-tilt>
                <span class="folder-tab"></span>
                <span class="card-index">{String(p.n + 1).padStart(2, '0')}</span>
                <div class="docs">
                  {p.images.slice(0, 3).map((img, di) => (
                    <div class={`doc doc-${di + 1}`}>
                      <img src={img} alt={p.name} loading="lazy" />
                    </div>
                  ))}
                </div>
                <span class="glass" aria-hidden="true"></span>
                <div class="front">
                  <span class="card-cat">{p.category}</span>
                  <h3 class="card-name">{p.name}</h3>
                  <span class="card-go">View project ↗</span>
                </div>
              </div>
            </a>
          ))}
        </div>

        <div class="track-end" aria-hidden="true">
          <span class="eyebrow">End of selected work</span>
          <a href="/#contact" class="track-end-cta">Start a project →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .projects { position: relative; background: var(--cream); }
  .pin-wrap {
    height: 100vh;
    height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(20px, 3vw, 38px);
    overflow: hidden;
    padding-block: 40px;
  }
  .proj-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .h-track-outer { overflow: visible; }
  .h-track {
    display: flex;
    align-items: stretch;
    gap: clamp(22px, 3vw, 52px);
    padding-inline: var(--gutter);
    width: max-content;
    will-change: transform;
  }
  /* Clean two-row grid — columns align, gaps are uniform. */
  .h-grid {
    flex: 0 0 auto;
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(2, min(33vh, 290px));
    grid-auto-columns: clamp(232px, 24vw, 336px);
    column-gap: clamp(30px, 3vw, 52px);
    row-gap: clamp(34px, 3.6vw, 52px);
  }

  /* ---- 3D hover wrapper (grid item) ---- */
  .card {
    perspective: 900px;
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    z-index: 1;
  }
  /* lift the open card above its neighbours so risen docs aren't clipped */
  .card:hover { z-index: 30; }

  /* ---- Realistic folder ---- */
  .folder {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    will-change: transform;
    /* back panel of the folder */
    background: linear-gradient(170deg, var(--green-600), var(--green-800));
    border-radius: 6px 16px 16px 16px;
    box-shadow:
      0 16px 30px -22px rgba(16, 42, 19, 0.6),
      inset 0 1px 0 rgba(243, 244, 221, 0.12);
  }
  /* the folder tab — trapezoid with slanted sides */
  .folder-tab {
    position: absolute;
    top: -14px;
    left: 10px;
    width: 44%;
    height: 18px;
    background: linear-gradient(170deg, var(--green-600), var(--green-700));
    border-radius: 7px 10px 0 0;
    clip-path: polygon(0 0, 86% 0, 100% 100%, 0 100%);
    box-shadow: inset 0 1px 0 rgba(243, 244, 221, 0.14);
    transform: translateZ(6px);
  }
  .card-index {
    position: absolute;
    top: 12px;
    right: 16px;
    z-index: 5;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: rgba(243, 244, 221, 0.65);
    transform: translateZ(28px);
  }

  /* stack of documents (screenshots) tucked inside the folder pocket */
  .docs {
    position: absolute;
    top: 11px;
    left: 9px;
    right: 9px;
    bottom: 17%;
    transform-style: preserve-3d;
    pointer-events: none;
  }
  .doc {
    position: absolute;
    inset: 0;
    border-radius: 3px 10px 4px 4px;
    overflow: hidden;
    background: transparent;
    transform-origin: 50% 100%;
    backface-visibility: hidden;
    will-change: transform;
    transition: transform 0.6s cubic-bezier(0.34, 1.4, 0.5, 1), box-shadow 0.6s ease;
  }
  /* closed: a neat stack fully sealed inside the folder, behind the glass */
  .doc-1 { transform: translateZ(18px); }
  .doc-2 { transform: translateZ(11px); }
  .doc-3 { transform: translateZ(4px); }

  /* frosted-glass front that seals & blurs the documents when closed */
  .glass {
    position: absolute;
    top: 9px;
    left: 8px;
    right: 8px;
    bottom: 15%;
    border-radius: 3px 11px 5px 5px;
    background: linear-gradient(
      165deg,
      rgba(16, 42, 19, 0.34),
      rgba(16, 42, 19, 0.52) 60%,
      rgba(16, 42, 19, 0.66)
    );
    border: 1px solid rgba(243, 244, 221, 0.1);
    box-shadow:
      inset 0 1px 0 rgba(243, 244, 221, 0.14),
      inset 0 -10px 22px -10px rgba(16, 42, 19, 0.55);
    transform: translateZ(22px);
    transform-origin: 50% 100%;
    transition: opacity 0.45s ease, transform 0.6s cubic-bezier(0.34, 1.4, 0.5, 1);
    pointer-events: none;
  }
  /* a soft sheen streak across the glass */
  .glass::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(115deg, transparent 40%, rgba(243, 244, 221, 0.08) 50%, transparent 62%);
  }
  /* opening: the glass clears so the lifted documents read sharply */
  .card:hover .glass {
    opacity: 0;
    transform: translateZ(22px) translateY(-12%) scale(1.03);
  }

  .doc img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* closed: screenshots are blurred behind the glass. Scaled up so the
       blur fringe never exposes the doc edges. */
    transform: scale(1.1);
    filter: blur(7px) brightness(0.94);
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1), filter 0.55s ease;
  }
  /* opening: screenshots sharpen and show in full (contain) so neither
     mobile (portrait) nor desktop (landscape) shots get cropped. */
  .card:hover .doc img {
    filter: blur(0) brightness(1) drop-shadow(0 14px 20px rgba(16, 42, 19, 0.5));
    transform: scale(1);
    object-fit: contain;
  }

  /* open: documents rise out of the folder and fan apart */
  .card:hover .doc-1 {
    transform: translateZ(64px) translateY(-26%) rotate(0deg);
  }
  .card:hover .doc-2 {
    transform: translateZ(46px) translateY(-30%) translateX(-30%) rotate(-13deg);
  }
  .card:hover .doc-3 {
    transform: translateZ(28px) translateY(-25%) translateX(30%) rotate(13deg);
  }

  /* the front panel of the folder */
  .front {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    /* Grow upward to fit a 2-line title instead of letting content
       overflow the top of the panel onto the screenshot. */
    min-height: 26%;
    padding: clamp(14px, 1.5vw, 22px) clamp(15px, 1.6vw, 24px) clamp(13px, 1.4vw, 20px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 5px;
    background: linear-gradient(175deg, var(--green-800), var(--green-900));
    border-radius: 0 0 16px 16px;
    box-shadow:
      0 -6px 12px -3px rgba(16, 42, 19, 0.4),
      inset 0 1px 0 rgba(243, 244, 221, 0.1);
    transform: translateZ(24px);
    transform-origin: 50% 100%;
    transition: transform 0.6s cubic-bezier(0.34, 1.4, 0.5, 1);
    color: var(--cream);
  }
  /* the pocket tips forward, opening like a folder flap */
  .card:hover .front {
    transform: translateZ(40px) rotateX(-32deg);
  }
  .card-cat {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mint);
  }
  .card-name {
    font-family: var(--serif);
    font-size: clamp(19px, 1.8vw, 28px);
    line-height: 1.04;
    font-weight: 500;
    /* Cap at two lines so the panel never grows unbounded. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-go {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(243, 244, 221, 0.75);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .card:hover .card-go { opacity: 1; transform: translateY(0); }

  .track-end {
    align-self: stretch;
    width: clamp(220px, 22vw, 300px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
  }
  .track-end-cta {
    font-family: var(--serif);
    font-size: clamp(28px, 3vw, 46px);
    font-weight: 500;
    color: var(--ink);
    transition: color 0.3s ease;
  }
  .track-end-cta:hover { color: var(--accent-deep); }

  /* Fallback: native horizontal scroll when motion is reduced / on touch.
     Height auto removes the pinned-section clipping; snap + contained
     overscroll make the swipe feel native and stop it triggering back-nav. */
  .projects.native .pin-wrap { height: auto; }
  .projects.native .h-track-outer {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-left: var(--gutter);
  }
  .projects.native .card { scroll-snap-align: start; }

  @media (max-width: 760px) {
    .h-grid {
      grid-template-rows: repeat(2, 40vh);
      grid-auto-columns: 74vw;
      row-gap: 28px;
    }
  }
</style>
