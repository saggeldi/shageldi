---
import { profile } from '../data/portfolio';
import Flower from './Flower.astro';

const italicWord = profile.headlineItalic;

// Skill icons that orbit around the hero portrait. Evenly spaced around the ring.
const orbitIcons = [
  { src: '/skills/kotlin.svg', label: 'Kotlin' },
  { src: '/skills/compose multiplatform.svg', label: 'Compose Multiplatform' },
  { src: '/skills/java.svg', label: 'Java' },
  { src: '/skills/typescript.svg', label: 'TypeScript' },
  { src: '/skills/reactjs.svg', label: 'React' },
  { src: '/skills/nestjs.svg', label: 'NestJS' },
  { src: '/skills/postgresql.svg', label: 'PostgreSQL' },
  { src: '/skills/docker.svg', label: 'Docker' },
];
---

<section class="hero" id="top">
  <div class="hero-grad" data-hero-grad></div>

  <div class="wrap hero-inner">
    <div class="hero-top">
      <span class="chip" data-reveal>
        <Flower class="chip-flower" /> {profile.available}
      </span>
      <p class="hero-meta" data-reveal>
        {profile.role} · KMP &amp; Web<br />
        {profile.location} · Remote
      </p>
    </div>

    <div class="hero-main">
      <div class="hero-text">
        <h1 class="hero-title" data-hero-title>
          {profile.headline.map((word, i) => (
            <>
              <span class={`word${word.startsWith(italicWord) ? ' italic' : ''}`}>{word}</span>
              {i < profile.headline.length - 1 ? ' ' : ''}
            </>
          ))}
        </h1>

        <p class="hero-lead" data-reveal>{profile.heroLead}</p>

        <div class="hero-cta-row" data-reveal>
          <a href="/#contact" class="hero-cta"><span></span> Start a project</a>
          <a href="/#projects" class="hero-cta ghost">See selected work</a>
        </div>
      </div>

      <figure class="hero-orbit" data-hero-portrait>
        <span class="orbit-glow" aria-hidden="true"></span>
        <span class="orbit-ring" aria-hidden="true"></span>
        <span class="orbit-ring orbit-ring--inner" aria-hidden="true"></span>

        <div class="orbit-photo">
          <canvas class="orbit-matrix" aria-hidden="true"></canvas>
          <img src="/images/hero-image.png" alt={profile.name} width="440" height="440" loading="eager" />
        </div>

        <div class="orbit-icons" aria-hidden="true">
          {orbitIcons.map((icon, i) => (
            <span class="orbit-icon" style={`--a:${(360 / orbitIcons.length) * i}deg`}>
              <span class="orbit-icon-inner">
                <img src={icon.src} alt={icon.label} width="28" height="28" loading="lazy" />
              </span>
            </span>
          ))}
        </div>
      </figure>
    </div>

    <span class="scroll-hint" data-reveal>Scroll to explore ↓</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-block: clamp(110px, 14vh, 150px) 48px;
  }
  .hero-grad {
    position: absolute;
    inset: -10% -10% auto -10%;
    height: 130%;
    background: var(--hero-grad);
    z-index: -1;
    will-change: transform;
  }
  .hero-inner { width: 100%; }

  .hero-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    margin-bottom: clamp(26px, 4vw, 48px);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-radius: 100px;
    background: rgba(243, 244, 221, 0.4);
    backdrop-filter: blur(6px);
  }
  .hero-meta {
    margin: 0;
    text-align: right;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    line-height: 1.7;
  }

  .hero-main {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 0.85fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .hero-text { min-width: 0; }
  .hero-title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(46px, 8vw, 116px);
    line-height: 0.92;
    letter-spacing: -0.025em;
    margin: 0;
    overflow-wrap: normal;
    hyphens: none;
    max-width: 13ch;
  }
  .hero-title .word { display: inline-block; }

  .hero-lead {
    margin: clamp(24px, 3vw, 38px) 0 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(17px, 1.5vw, 22px);
    line-height: 1.45;
    color: var(--green-700);
    max-width: 42ch;
  }

  .hero-cta-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: clamp(26px, 3vw, 38px);
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: var(--green-800);
    color: var(--cream);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 13px 22px;
    border-radius: 100px;
    transition: transform 0.3s ease, background 0.3s ease;
  }
  .hero-cta span { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
  .hero-cta:hover { transform: translateY(-2px); }
  .hero-cta.ghost { background: transparent; color: var(--ink); border: 1px solid var(--line); }

  /* ── Animated orbit portrait ───────────────────────────── */
  .hero-orbit {
    --size: min(86vw, 380px);
    --r: calc(var(--size) / 2);
    --chip: 52px;
    position: relative;
    margin: 0;
    justify-self: end;
    width: var(--size);
    height: var(--size);
    flex-shrink: 0;
  }

  /* soft radiant glow behind the whole thing */
  .orbit-glow {
    position: absolute;
    inset: -14%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 45%, var(--mint) 0%, rgba(199, 226, 205, 0.35) 45%, transparent 70%);
    filter: blur(8px);
    z-index: 0;
    animation: orbit-pulse 6s ease-in-out infinite;
  }

  /* rotating dashed rings */
  .orbit-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px dashed rgba(19, 55, 22, 0.28);
    z-index: 1;
    animation: orbit-spin 26s linear infinite;
  }
  .orbit-ring--inner {
    inset: 11%;
    border-style: solid;
    border-color: rgba(0, 199, 88, 0.22);
    animation-duration: 38s;
    animation-direction: reverse;
  }

  /* circular photo with gradient background */
  .orbit-photo {
    position: absolute;
    inset: 13%;
    border-radius: 50%;
    overflow: hidden;
    z-index: 2;
    background: radial-gradient(circle at 50% 25%, var(--green-700) 0%, var(--green-900) 70%, #0b1f0e 100%);
    box-shadow: inset 0 0 0 1px rgba(243, 244, 221, 0.12), 0 30px 70px -32px rgba(16, 42, 19, 0.6);
  }
  .orbit-matrix {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0.85;
  }
  .orbit-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 8%;
    z-index: 1;
  }

  /* the orbiting icon track */
  .orbit-icons {
    position: absolute;
    inset: 0;
    z-index: 3;
    animation: orbit-spin 26s linear infinite;
  }
  .orbit-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--chip);
    height: var(--chip);
    margin: calc(var(--chip) / -2);
    transform: rotate(var(--a)) translateY(calc(var(--r) * -1)) rotate(calc(var(--a) * -1));
  }
  /* counter-rotate so each chip stays upright while the track spins */
  .orbit-icon-inner {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--cream);
    border: 1px solid var(--line);
    box-shadow: 0 8px 20px -10px rgba(16, 42, 19, 0.5);
    animation: orbit-spin 26s linear infinite reverse;
  }
  .orbit-icon-inner img {
    width: 58%;
    height: 58%;
    object-fit: contain;
  }

  @keyframes orbit-spin { to { transform: rotate(360deg); } }
  @keyframes orbit-pulse {
    0%, 100% { transform: scale(1); opacity: 0.85; }
    50% { transform: scale(1.06); opacity: 1; }
  }

  .scroll-hint {
    display: block;
    margin-top: clamp(30px, 4vw, 52px);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  @media (max-width: 860px) {
    .hero-main { grid-template-columns: 1fr; gap: 30px; justify-items: center; text-align: center; }
    .hero-text { display: flex; flex-direction: column; align-items: center; }
    .hero-title { max-width: none; font-size: clamp(48px, 15vw, 92px); }
    .hero-lead { max-width: 48ch; margin-inline: auto; }
    .hero-cta-row { justify-content: center; }
    .hero-orbit {
      order: -1;
      justify-self: center;
      margin-inline: auto;
      --size: min(82vw, 320px);
      --chip: 46px;
    }
  }
  @media (max-width: 460px) {
    .hero-orbit { --chip: 40px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit-ring,
    .orbit-icons,
    .orbit-icon-inner,
    .orbit-glow { animation: none; }
  }
</style>

<script>
  // Matrix-style binary (0/1) rain behind the hero portrait.
  function initMatrix(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let cols = 0, fontSize = 12, w = 0, h = 0;
    let drops: number[] = [];

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = canvas.getBoundingClientRect();
      w = rect.width; h = rect.height;
      if (!w || !h) return;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      fontSize = Math.max(11, w / 16);
      cols = Math.ceil(w / fontSize) + 1;
      drops = Array.from({ length: cols }, () => Math.random() * (h / fontSize));
    }

    function draw() {
      // translucent green wash creates the fading trail
      ctx!.fillStyle = 'rgba(11, 31, 14, 0.16)';
      ctx!.fillRect(0, 0, w, h);
      ctx!.font = `700 ${fontSize}px "JetBrains Mono", monospace`;
      ctx!.textBaseline = 'top';
      for (let i = 0; i < cols; i++) {
        const ch = Math.random() < 0.5 ? '0' : '1';
        const x = i * fontSize;
        const y = drops[i] * fontSize;
        // occasional bright leading glyph, rest soft green
        ctx!.fillStyle = Math.random() < 0.07 ? 'rgba(214, 240, 220, 0.95)' : 'rgba(0, 199, 88, 0.6)';
        ctx!.fillText(ch, x, y);
        if (y > h && Math.random() > 0.97) drops[i] = 0;
        else drops[i] += 1;
      }
    }

    resize();
    window.addEventListener('resize', resize);

    if (reduced) { draw(); return; }
    let last = 0;
    function loop(t: number) {
      if (t - last > 80) { draw(); last = t; }
      requestAnimationFrame(loop);
    }
    requestAnimationFrame(loop);
  }

  document.querySelectorAll<HTMLCanvasElement>('.orbit-matrix').forEach(initMatrix);
</script>
