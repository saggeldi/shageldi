---
import { services } from '../data/portfolio';
import Flower from './Flower.astro';
---

<section class="section dark services" id="services">
  <div class="wrap">
    <div class="serv-head">
      <div>
        <span class="eyebrow" data-reveal>02 / What I do</span>
        <h2 class="section-title serv-title" data-reveal>Services <Flower /></h2>
      </div>
      <p class="serv-note" data-reveal>
        Can't see what you need?<br />Let's scope a custom build with your team.
      </p>
    </div>

    <div class="serv-list">
      {services.map((s, i) => (
        <article class="serv-row" data-reveal>
          <div class="serv-no">{String(i + 1).padStart(2, '0')}</div>
          <h3 class="serv-name">{s.title} <em class="italic">{s.italic}</em></h3>
          <p class="serv-desc">{s.description}</p>
          <div class="serv-tags">
            {s.tags.map((tag) => <span class="pill">{tag}</span>)}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .serv-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: clamp(30px, 5vw, 56px);
  }
  .serv-title { margin-top: 14px; }
  .serv-note {
    margin: 0;
    text-align: right;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    line-height: 1.8;
  }
  .serv-row {
    display: grid;
    grid-template-columns: 56px minmax(220px, 1.1fr) 1.5fr;
    gap: clamp(16px, 3vw, 48px);
    align-items: start;
    padding-block: clamp(28px, 4vw, 50px);
    border-top: 1px solid var(--line);
  }
  .serv-row:last-child { border-bottom: 1px solid var(--line); }
  .serv-no {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-faint);
    padding-top: 12px;
  }
  .serv-name {
    font-family: var(--serif);
    font-size: clamp(30px, 3.6vw, 52px);
    line-height: 1.02;
    font-weight: 500;
  }
  .serv-name em { color: var(--accent); }
  .serv-desc {
    margin: 0 0 20px;
    color: var(--ink-soft);
    font-size: 16px;
    line-height: 1.65;
    max-width: 52ch;
  }
  .serv-tags {
    grid-column: 2 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }

  @media (max-width: 820px) {
    .serv-row { grid-template-columns: 1fr; gap: 14px; }
    .serv-no { padding-top: 0; }
    .serv-tags { grid-column: 1; }
  }
  @media (max-width: 620px) {
    .serv-head { flex-direction: column; align-items: flex-start; }
    .serv-note { text-align: left; }
  }
</style>
