---
import { profile, skills } from '../data/portfolio';

// Render `_italic_` accents inside the about copy.
const parts = profile.about.split(/(_[^_]+_)/g).filter(Boolean);
---

<section class="section about" id="about">
  <div class="wrap">
    <div class="about-head" data-reveal>
      <span class="eyebrow">01 / Who I am</span>
      <span class="eyebrow">Based in {profile.location}</span>
    </div>

    <p class="about-copy" data-about-copy>
      {parts.map((p) =>
        p.startsWith('_') && p.endsWith('_')
          ? <em class="italic">{p.slice(1, -1)}</em>
          : <span>{p}</span>
      )}
    </p>

    <div class="about-skills" data-reveal>
      {skills.map((s) => <span class="pill">{s}</span>)}
    </div>
  </div>
</section>

<style>
  .about-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 26px;
    margin-bottom: clamp(34px, 5vw, 60px);
    border-bottom: 1px solid var(--line);
  }
  .about-copy {
    font-family: var(--serif);
    font-size: clamp(28px, 4.4vw, 58px);
    line-height: 1.18;
    font-weight: 500;
    letter-spacing: -0.01em;
    max-width: 20ch;
    margin: 0;
  }
  .about-copy { max-width: none; }
  .about-copy em { color: var(--accent-deep); }
  .about-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: clamp(40px, 5vw, 64px);
  }
</style>
