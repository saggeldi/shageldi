---
import { profile } from '../data/portfolio';

const budgets = ['< $2k', '$2–5k', '$5–10k', '$10k+'];
---

<section class="section dark contact" id="contact">
  <div class="wrap">
    <header class="contact-head" data-reveal>
      <span class="eyebrow">03 / Get in touch</span>
      <h2 class="contact-title">Let's <em class="italic">collab</em></h2>
      <p class="contact-sub">Tell me about your project — I'll reply within a day.</p>
    </header>

    <div class="contact-grid">
      <form class="contact-form" data-contact-form data-reveal>
        <div class="field-row">
          <label class="field">
            <span>Name</span>
            <input type="text" name="name" required placeholder="Your name" />
          </label>
          <label class="field">
            <span>Email</span>
            <input type="email" name="email" required placeholder="you@email.com" />
          </label>
        </div>

        <label class="field">
          <span>Company / Project</span>
          <input type="text" name="project" placeholder="What are we building?" />
        </label>

        <fieldset class="field budget">
          <span>Budget</span>
          <div class="budget-opts">
            {budgets.map((b, i) => (
              <label class="radio">
                <input type="radio" name="budget" value={b} checked={i === 1} />
                <span>{b}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <label class="field">
          <span>Brief</span>
          <textarea name="message" rows="4" required placeholder="A few lines about scope, platform and timeline…"></textarea>
        </label>

        <button type="submit" class="submit">Send brief →</button>
      </form>

      <aside class="contact-direct" data-reveal>
        <span class="eyebrow">Or write directly</span>
        <a class="direct-email" href={`mailto:${profile.email}`}>{profile.email}</a>
        <p class="direct-note">For new work, partnerships or detailed briefs, I usually reply within a day.</p>

        <ul class="direct-links">
          <li><a href={profile.socials.linkedin} target="_blank" rel="noopener">LinkedIn <span>↗</span></a></li>
          <li><a href={profile.socials.github} target="_blank" rel="noopener">GitHub <span>↗</span></a></li>
          <li><a href={profile.socials.telegram} target="_blank" rel="noopener">Telegram <span>↗</span></a></li>
          <li><a href={profile.socials.instagram} target="_blank" rel="noopener">Instagram <span>↗</span></a></li>
          <li><a href={`tel:${profile.phone.replace(/\s/g, '')}`}>{profile.phone} <span>↗</span></a></li>
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .contact-head { margin-bottom: clamp(34px, 5vw, 60px); }
  .contact-title {
    font-family: var(--serif);
    font-size: clamp(58px, 11vw, 150px);
    line-height: 0.9;
    font-weight: 500;
    margin: 10px 0 0;
  }
  .contact-title em { color: var(--accent); }
  .contact-sub { color: var(--ink-soft); margin: 14px 0 0; font-size: 16px; }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(28px, 5vw, 70px);
  }
  .contact-form { display: flex; flex-direction: column; gap: 18px; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .field { display: flex; flex-direction: column; gap: 9px; border: 0; padding: 0; margin: 0; min-width: 0; }
  .field > span {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .field input,
  .field textarea {
    background: rgba(243, 244, 221, 0.06);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 14px 16px;
    color: var(--cream);
    font-family: var(--sans);
    /* 16px min keeps iOS Safari from auto-zooming on focus. */
    font-size: 16px;
    outline: none;
    transition: border-color 0.3s ease, background 0.3s ease;
  }
  .field input::placeholder,
  .field textarea::placeholder { color: rgba(243, 244, 221, 0.35); }
  .field input:focus,
  .field textarea:focus { border-color: var(--accent); background: rgba(243, 244, 221, 0.1); }
  .field textarea { resize: vertical; }

  .budget-opts { display: flex; flex-wrap: wrap; gap: 8px; }
  .radio { position: relative; }
  .radio input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .radio span {
    display: inline-block;
    padding: 12px 18px;
    border: 1px solid var(--line);
    border-radius: 100px;
    font-family: var(--mono);
    font-size: 12px;
    transition: all 0.25s ease;
  }
  .radio input:checked + span {
    background: var(--accent);
    color: var(--green-900);
    border-color: var(--accent);
  }

  .submit {
    margin-top: 6px;
    align-self: flex-start;
    background: var(--cream);
    color: var(--green-900);
    border: 0;
    border-radius: 100px;
    padding: 15px 30px;
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.3s ease, background 0.3s ease;
  }
  .submit:hover { transform: translateY(-2px); background: var(--accent); }

  .contact-direct { display: flex; flex-direction: column; gap: 16px; }
  .direct-email {
    font-family: var(--serif);
    font-size: clamp(22px, 2.4vw, 32px);
    font-weight: 500;
    border-bottom: 1px solid var(--line);
    padding-bottom: 18px;
    word-break: break-all;
    transition: color 0.3s ease;
  }
  .direct-email:hover { color: var(--accent); }
  .direct-note { color: var(--ink-soft); font-size: 14px; margin: 0; line-height: 1.6; }
  .direct-links { list-style: none; margin: 8px 0 0; padding: 0; }
  .direct-links li { border-top: 1px solid var(--line); }
  .direct-links li:last-child { border-bottom: 1px solid var(--line); }
  .direct-links a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 2px;
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: padding-left 0.3s ease, color 0.3s ease;
  }
  .direct-links a:hover { padding-left: 10px; color: var(--accent); }
  .direct-links span { color: var(--ink-faint); }

  @media (max-width: 820px) {
    .contact-grid { grid-template-columns: 1fr; }
    .field-row { grid-template-columns: 1fr; }
  }
</style>

<script>
  const form = document.querySelector('[data-contact-form]') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = new FormData(form);
    const name = (f.get('name') || '').toString();
    const subject = `New project enquiry — ${name}`;
    const body = [
      `Name: ${name}`,
      `Email: ${f.get('email') || ''}`,
      `Company / Project: ${f.get('project') || ''}`,
      `Budget: ${f.get('budget') || ''}`,
      '',
      `${f.get('message') || ''}`,
    ].join('\n');
    window.location.href = `mailto:multiplatform00@gmail.com?subject=${encodeURIComponent(
      subject
    )}&body=${encodeURIComponent(body)}`;
  });
</script>
