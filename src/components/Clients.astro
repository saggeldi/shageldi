---
import { clients } from '../data/portfolio';
const row = [...clients, ...clients];
---

<section class="clients">
  <div class="marquee" data-marquee>
    <div class="marquee-track" data-marquee-track>
      {row.map((c) => <span class="client">{c}</span>)}
    </div>
    <div class="marquee-track" data-marquee-track aria-hidden="true">
      {row.map((c) => <span class="client">{c}</span>)}
    </div>
  </div>
</section>

<style>
  .clients {
    border-block: 1px solid var(--line);
    padding-block: clamp(26px, 4vw, 44px);
    overflow: hidden;
  }
  .marquee { display: flex; width: max-content; gap: 0; }
  .marquee-track {
    display: flex;
    align-items: center;
    gap: clamp(40px, 6vw, 90px);
    padding-right: clamp(40px, 6vw, 90px);
    will-change: transform;
  }
  .client {
    font-family: var(--serif);
    font-size: clamp(26px, 3.4vw, 46px);
    font-weight: 500;
    color: var(--ink-soft);
    white-space: nowrap;
    transition: color 0.3s ease;
  }
  .client:hover { color: var(--ink); }
</style>
