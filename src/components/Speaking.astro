---
import { speaking } from '../data/portfolio';
import Flower from './Flower.astro';

// First & last cards run wide; the video + candid sit in the middle row.
const spans = [7, 5, 5, 7];
const cards = speaking.map((t, i) => ({ ...t, span: spans[i] ?? 6 }));
---

<section class="section speaking dark" id="speaking">
  <div class="wrap">
    <div class="speak-head" data-reveal>
      <h2 class="section-title">
        Speaking <Flower />
      </h2>
      <span class="eyebrow">{speaking.length} talks · GDG / DevFest · 2025</span>
    </div>

    <div class="speak-grid">
      {cards.map((t) => (
        <figure class="speak-card" style={`--span:${t.span}`} data-reveal>
          <div class="speak-media">
            {t.type === 'video' ? (
              <video
                src={encodeURI(t.media)}
                controls
                preload="metadata"
                playsinline
                muted
              ></video>
            ) : (
              <img src={encodeURI(t.media)} alt={t.title} loading="lazy" />
            )}
          </div>
          <figcaption class="speak-cap">
            <span class="eyebrow speak-event">{t.event}</span>
            <h3 class="speak-title">{t.title}</h3>
            {t.link && (
              <a class="speak-watch" href={t.link} target="_blank" rel="noopener noreferrer">
                Watch the recording ↗
              </a>
            )}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .speak-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: clamp(34px, 5vw, 64px);
  }
  /* Flower is a child component; reach it with :global so it reads on dark. */
  .speak-head :global(.flower-mark) { color: var(--accent); }

  .speak-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(18px, 2.2vw, 34px);
  }
  .speak-card {
    grid-column: span var(--span);
    margin: 0;
    display: flex;
    flex-direction: column;
    background: rgba(243, 244, 221, 0.04);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    transition: border-color 0.4s ease, transform 0.4s ease;
  }
  .speak-card:hover {
    border-color: rgba(243, 244, 221, 0.3);
    transform: translateY(-4px);
  }

  .speak-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--green-900);
  }
  .speak-media img,
  .speak-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .speak-media img {
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .speak-card:hover .speak-media img { transform: scale(1.04); }

  .speak-cap {
    padding: clamp(18px, 1.8vw, 26px);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .speak-event { color: var(--accent); }
  .speak-title {
    font-family: var(--serif);
    font-size: clamp(20px, 2vw, 28px);
    line-height: 1.12;
    font-weight: 500;
    margin: 0;
    color: var(--cream);
  }
  .speak-watch {
    margin-top: 4px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mint);
    transition: color 0.3s ease;
  }
  .speak-watch:hover { color: var(--accent); }

  @media (max-width: 900px) {
    .speak-card { grid-column: span 6; }
  }
  @media (max-width: 620px) {
    .speak-grid { grid-template-columns: 1fr; }
    .speak-card { grid-column: 1 / -1; }
  }
</style>
