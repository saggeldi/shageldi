---
import '../styles/global.css';
import { profile } from '../data/portfolio';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: string;
  noindex?: boolean;
}

const {
  title = `${profile.name} — ${profile.role}`,
  description = profile.aboutLong.slice(0, 155),
  image = '/images/meta-banner.png',
  imageAlt = `${profile.name} — ${profile.role}`,
  type = 'website',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const twitterHandle = '@sh_alyyv';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  telephone: profile.phone,
  url: Astro.site?.toString(),
  address: { '@type': 'PostalAddress', addressLocality: profile.location },
  sameAs: Object.values(profile.socials),
  knowsAbout: ['Android', 'Kotlin', 'Kotlin Multiplatform', 'Jetpack Compose', 'React', 'NestJS'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#133716" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph (Facebook, LinkedIn, WhatsApp, Telegram, Slack, Discord…) -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1424" />
    <meta property="og:image:height" content="752" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterHandle} />
    <meta name="twitter:creator" content={twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Geist:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />

    <!-- Jule.ai widget -->
    <script is:inline>
      (function () {
        var s = document.createElement('script');
        s.src = 'https://assets.jule.ai/widget.js';
        s.dataset.apiKey = 'pk_workspace_532b0f2ece56586b81c3a2a09f289aeaf6630ba69c3b8a2d';
        s.async = true;
        (document.body || document.head).appendChild(s);
      })();
    </script>
  </body>
</html>
